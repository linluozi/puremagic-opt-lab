+def _build_header_index(header_array):
+    """Index header signatures by the byte they compare first.
+
+    Offset-0 rows are bucketed by their first byte. Positive-offset rows stay
+    in their original order, because their first compared byte lives at
+    ``header[offset]`` and is only known at call time. Buckets are pre-merged
+    per possible first byte so the stable confidence tie-break keeps the
+    original signature order without sorting on every call.
+    """
+    at_zero = {}
+    at_offset = []
+    for order, row in enumerate(header_array):
+        if not row.byte_match or row.offset != 0:
+            at_offset.append((order, row))
+        else:
+            at_zero.setdefault(row.byte_match[0], []).append((order, row))
+    merged = {}
+    for first_byte in range(256):
+        merged[first_byte] = tuple(
+            sorted(list(at_zero.get(first_byte, ())) + at_offset, key=lambda item: item[0])
+        )
+    return merged, tuple(at_offset)
+
+
+_header_by_first_byte, _header_at_offset = _build_header_index(magic_header_array)
+_ALL_EXTENSIONS = frozenset(
+    row.extension for row in chain(magic_header_array, magic_footer_array) if isinstance(row.extension, str)
+)

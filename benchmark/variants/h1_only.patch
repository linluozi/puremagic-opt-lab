+def _build_zero_index(header_array):
+    at_zero = {}
+    at_offset = []
+    for order, row in enumerate(header_array):
+        if not row.byte_match or row.offset != 0:
+            at_offset.append((order, row))
+        else:
+            at_zero.setdefault(row.byte_match[0], []).append((order, row))
+    at_offset.sort(key=lambda item: item[0])
+    merged = {}
+    for first_byte in range(256):
+        merged[first_byte] = tuple(sorted(list(at_zero.get(first_byte, ())) + at_offset, key=lambda item: item[0]))
+    return merged, tuple(at_offset)
+
+
+_header_by_first_byte, _header_at_offset = _build_zero_index(magic_header_array)
